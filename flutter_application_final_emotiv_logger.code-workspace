{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "workbench.colorCustomizations": {
      "editor.lineHighlightBackground": "#7d4b102d",
      "editor.lineHighlightBorder": "#d1a89f1f",
      "activityBar.background": "#4b2423",
      "titleBar.activeBackground": "#c77953",
      "titleBar.activeForeground": "#000000",
      "scrollbarSlider.background": "#ff7f0057",
      "scrollbarSlider.hoverBackground": "#ff7f0082",
      "scrollbarSlider.activeBackground": "#cc7f00df",
      "activityBar.inactiveForeground": "#ffffff3c",
      "activityBar.foreground": "#ffffff",
      "notebook.outputContainerBackgroundColor": "#5a3e3950",
      "notebook.outputContainerBorderColor": "#ff7f10",
      "notebook.focusedCellBorder": "#ffa500da",
      "notebook.focusedEditorBorder": "#ffa500",
      "notebook.inactiveFocusedCellBorder": "#ffa50063",
      "titleBar.inactiveBackground": "#c779528e",
      "tab.activeBorder": "#3C2E2E",
      "statusBar.background": "#3C2E2E",
      "statusBar.foreground": "#ffffff",
      "sideBarSectionHeader.border": "#cecece"
    },
    "python.languageServer": "None",
    "dart.flutterSdkPath": ".fvm/versions/3.47.9",
    "actionButtons": {
      "defaultColor": "white",
      "reloadButton": "↻",
      "loadNpmCommands": false,
      "commands": [
        {
          "name": "$(tools) Build",
          "color": "#ed9600",
          "tooltip": "Release build+run on the device selected in the Flutter status bar (.env defines)",
          "useVsCodeApi": true,
          "command": "debug.startFromConfig",
          "args": [
            {
              "name": "flutter_application_final_emotiv_logger (release mode)",
              "request": "launch",
              "type": "dart",
              "flutterMode": "release",
              "toolArgs": [
                "--dart-define-from-file=.env"
              ]
            }
          ]
        },
        {
          "name": "$(play) Run",
          "color": "#4ec9b0",
          "tooltip": "Start Without Debugging on the device selected in the Flutter status bar",
          "useVsCodeApi": true,
          "command": "workbench.action.debug.run"
        },
        {
          "name": "$(debug-alt) Debug",
          "color": "#569cd6",
          "tooltip": "Start Debugging on the device selected in the Flutter status bar",
          "useVsCodeApi": true,
          "command": "workbench.action.debug.start"
        }
      ]
    }
  },
  "extensions": {
    "recommendations": [
      "dart-code.flutter",
      "jkearins.action-buttons-ext"
    ]
  }
}